{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "start-dev-command",
  "version": "0.1.0",
  "identifier": "com.haier.devrunner",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "项目管理器",
        "width": 600,
        "height": 500,
        "minWidth": 550,
        "minHeight": 450
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMyNzM0NjZDOTYyOTRENEQKUldSTlRTbVdiRVp6TXFQQW1QZmRidGlhZEdRSi9wYXdHemUzQUZnbWJQZE9lZkpLQ3hPdjZRdEkK",
      "endpoints": [
        "https://github.com/haierkeys/Start-Dev-Command/releases/latest/download/latest.json"
      ]
    }
  }
}
